{
    "name": "realtime-notification-service",
    "version": "1.0.0",
    "description": "Real-time notification service built with Node.js, Express, Server-Sent Events and Redis Pub/Sub",
    "main": "backend/server.js",
    "scripts": {
        "start": "node backend/server.js",
        "dev": "docker compose -f docker-compose.dev.yml up --build",
        "dev:down": "docker compose -f docker-compose.dev.yml down",
        "dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
        "prod": "docker compose up --build -d",
        "prod:down": "docker compose down",
        "prod:logs": "docker compose logs -f"
    },
    "keywords": [
        "nodejs",
        "express",
        "sse",
        "server-sent-events",
        "redis",
        "pub-sub",
        "realtime"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "redis": "^6.2.0"
    },
    "devDependencies": {
        "nodemon": "^3.1.14"
    }
}